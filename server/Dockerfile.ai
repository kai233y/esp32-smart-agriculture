FROM python:3.11-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
COPY server/requirements.txt /app/requirements.txt
COPY ai/requirements.txt /app/requirements-ai.txt
RUN pip install --no-cache-dir -r requirements.txt -r requirements-ai.txt
COPY server /app/server
RUN useradd -u 10001 -m farm && mkdir -p /app/server/data /app/models && chown -R farm:farm /app/server/data
USER farm
ENV YOLO_CONFIG_DIR=/tmp/ultralytics
EXPOSE 8000
CMD ["uvicorn", "server.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
